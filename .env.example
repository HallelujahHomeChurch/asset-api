PORT=8080
DATABASE_URL=postgres://asset:asset@localhost:5432/asset?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
ASSET_PUBLIC_BASE_URL=http://localhost:8080/api/assets
ASSET_STORAGE_BACKEND=local
ASSET_LOCAL_DIR=.data/assets
ASSET_LOCAL_UPLOAD_BASE_URL=http://localhost:8080/dev/uploads
ASSET_LOCAL_SIGNING_KEY=replace-with-at-least-32-random-bytes
ASSET_ALLOWED_CALLERS=account-api,hhc-web-api,hhc-line-function-bot
ASSET_ALLOW_DEV_CALLER_HEADER=true
ASSET_WORKLOAD_TENANT_ID=
ASSET_WORKLOAD_ISSUER=
ASSET_WORKLOAD_AUDIENCE=
ASSET_WORKLOAD_REQUIRED_ROLE=Asset.Invoke
ASSET_LINE_WORKLOAD_CLIENT_ID=
ASSET_LINE_WORKLOAD_OBJECT_ID=
CLAMAV_HOST=172.16.65.5
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=120
CLAMAV_MAX_FILE_SIZE_BYTES=26214400
CLAMAV_MAX_RETRIES=5

# Azure production
ASSET_AZURE_ACCOUNT_URL=https://YOUR_ACCOUNT.blob.core.windows.net
ASSET_AZURE_CONTAINER=assets
