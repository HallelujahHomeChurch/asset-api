FROM golang:1.26.9-bookworm@sha256:d9c68c2c51161e12fd77e4c6320687c9cd86e1af1e3ad6e6cd63ff970641453c AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /asset-scan-worker ./cmd/scan-worker
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /asset-signature-refresh ./cmd/signature-refresh

FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates clamav libpcre2-8-0 perl-base \
 && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' perl-base)" ge '5.36.0-7+deb12u4' \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /asset-scan-worker /asset-scan-worker
COPY --from=build /asset-signature-refresh /asset-signature-refresh
USER 65532:65532
STOPSIGNAL SIGTERM
ENTRYPOINT ["/asset-scan-worker"]
