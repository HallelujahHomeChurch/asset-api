FROM golang:1.26.11-bookworm@sha256:dc40a13b61304647ed7e5d581d246b86413dfc29d63c6d018310feb93cd98fc0 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN --mount=type=cache,id=asset-go-build,target=/root/.cache/go-build CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /asset-scan-worker ./cmd/scan-worker
RUN --mount=type=cache,id=asset-go-build,target=/root/.cache/go-build CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /asset-signature-refresh ./cmd/signature-refresh

FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends apt libapt-pkg6.0 ca-certificates clamav libpcre2-8-0 perl-base \
 && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' apt)" ge '2.6.2' \
 && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libapt-pkg6.0)" ge '2.6.2' \
 && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' perl-base)" ge '5.36.0-7+deb12u4' \
 && apt-get install -y --only-upgrade libpam0g libpam-modules libpam-modules-bin libpam-runtime libzstd1 \
 && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libzstd1)" ge '1.5.4+dfsg2-5+deb12u1' \
 && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libpam0g)" ge '1.5.2-6+deb12u3' \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /asset-scan-worker /asset-scan-worker
COPY --from=build /asset-signature-refresh /asset-signature-refresh
USER 65532:65532
STOPSIGNAL SIGTERM
ENTRYPOINT ["/asset-scan-worker"]
